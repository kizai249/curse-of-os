<Project Sdk="Microsoft.NET.Sdk">
  <!--
    يبني FootballQuest.Core (منطق C# بدون UnityEngine) واختباراته خارج Unity بـ dotnet،
    عشان تشتغل في CI بدون ترخيص Unity وبثواني. نفس الملفات تُبنى داخل Unity عبر asmdef.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- تحذيرات الكود المضمّن من طرف ثالث ما نعدّله. -->
    <NoWarn>$(NoWarn);CS0162;CS0168;CS0219;CS0414;CS0649</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../unity/FootballQuest/Assets/_Project/Scripts/Core/**/*.cs" />
    <Compile Include="../../unity/FootballQuest/Assets/_Project/Tests/EditMode/Core/**/*.cs" />
    <Compile Include="FontCoverage/**/*.cs" />
    <Compile Include="../../unity/FootballQuest/Assets/_Project/Scripts/Editor/Build/ManifestPermissions.cs" />
    <!-- منطق التشكيل في RTLTMPro نقي؛ المكونات المرتبطة بـ TextMeshPro مستبعدة. -->
    <Compile Include="../../unity/FootballQuest/Assets/ThirdParty/RTLTMPro/Scripts/Runtime/**/*.cs"
             Exclude="../../unity/FootballQuest/Assets/ThirdParty/RTLTMPro/Scripts/Runtime/RTLTextMeshPro*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
</Project>
