# رفع iOS لـ TestFlight من مشروع Xcode اللي يولّده Unity (GameCI).
# المتغيرات (أسرار GitHub — docs/RUNBOOK.md §5.2):
#   XCODE_PROJECT_DIR، BUILD_NUMBER، APPLE_TEAM_ID، ASC_KEY_ID، ASC_ISSUER_ID، ASC_KEY_P8_B64
default_platform(:ios)

platform :ios do
  desc "Build, sign (automatic, App Store Connect API key) and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_B64"),
      is_key_content_base64: true,
      in_house: false
    )

    key_path = File.expand_path("../AuthKey.p8")
    File.binwrite(key_path, Base64.decode64(ENV.fetch("ASC_KEY_P8_B64")))

    project = File.join(ENV.fetch("XCODE_PROJECT_DIR"), "Unity-iPhone.xcodeproj")
    update_code_signing_settings(
      path: project,
      use_automatic_signing: true,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      targets: ["Unity-iPhone"]
    )
    increment_build_number(xcodeproj: project, build_number: ENV.fetch("BUILD_NUMBER"))

    build_app(
      project: project,
      scheme: "Unity-iPhone",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/ipa",
      xcargs: [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath #{key_path}",
        "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
        "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}"
      ].join(" ")
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  ensure
    File.delete(key_path) if key_path && File.exist?(key_path)
  end
end
